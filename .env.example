# Local-only development configuration. Copy this file to .env and replace every
# placeholder before starting Docker Compose. Do not commit .env.
#
# Set every empty value below before starting Docker Compose. Generate passwords
# locally, for example: openssl rand -hex 32
POSTGRES_USER=a11y
POSTGRES_PASSWORD=
DATABASE_URL=
REDIS_URL=redis://127.0.0.1:6380

MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=a11y-evidence

# Optional: where evidence screenshots are written/served from.
# Defaults to <repo-root>/evidence when api/worker run from their app dirs.
# EVIDENCE_DIR=/absolute/path/to/evidence

# The API accepts only these local browser origins by default. Set an explicit,
# comma-separated list for an authorized local development frontend. CORS is not
# authentication and does not make this alpha service safe for shared hosting.
# CORS_ORIGIN=http://localhost:3010,http://127.0.0.1:3010

# The API only accepts loopback HOST values (127.0.0.1, localhost, or ::1).
# HOST=127.0.0.1

# Local-alpha scanner sidecar values. Leave blank here; `pnpm alpha:env` generates
# a fresh uncommitted PLAYWRIGHT_WS_TOKEN and docker-compose.alpha.yml derives
# the worker-only endpoint on the internal browser-control network.
PLAYWRIGHT_WS_TOKEN=
PLAYWRIGHT_WS_ENDPOINT=

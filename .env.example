# Ports below match docker-compose.yml (which uses non-default host ports
# to avoid clashing with locally installed Postgres/Redis).
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/a11y
REDIS_URL=redis://localhost:6380
# Optional: where evidence screenshots are written/served from.
# Defaults to <repo-root>/evidence when api/worker run from their app dirs.
# EVIDENCE_DIR=/absolute/path/to/evidence
# Optional: comma-separated list of allowed CORS origins (default: allow all).
# CORS_ORIGIN=http://localhost:3010
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123
S3_BUCKET=a11y-evidence

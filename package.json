{
  "name": "a11y-saas-monorepo",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "echo 'Run app-specific dev scripts'",
    "seed": "node scripts/seed.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:acceptance": "scripts/full-stack-acceptance.sh",
    "test:ui": "pnpm --filter @a11y/web build && node scripts/ui-acceptance.mjs",
    "test:scanner-egress": "node scripts/test-scanner-egress.mjs",
    "alpha:env": "node scripts/create-alpha-env.mjs"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@axe-core/react": "^4.11.1",
    "@fastify/cors": "^11.2.0",
    "@fastify/static": "^9.0.0",
    "@prisma/adapter-pg": "^7.4.1",
    "@prisma/client": "^7.4.1",
    "bullmq": "^5.70.0",
    "fastify": "^5.7.4",
    "ioredis": "^5.9.3",
    "pg": "^8.18.0",
    "playwright": "1.58.2",
    "pptxgenjs": "^4.0.1",
    "prisma": "^7.4.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.15.0",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "overrides": {
      "ioredis": "^5.9.3"
    }
  }
}

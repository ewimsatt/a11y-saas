generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(100)
  baseUrl   String   @db.VarChar(500)
  createdAt DateTime @default(now())
  scans     Scan[]
}

model Scan {
  id            String     @id @default(cuid())
  projectId     String
  status        ScanStatus @default(pending)
  coverage      ScanCoverage @default(PENDING)
  requestKey    String?    @unique @db.VarChar(255)
  requestDigest String?    @db.Char(64)
  startedAt     DateTime?
  completedAt   DateTime?
  updatedAt     DateTime   @updatedAt
  pages         Page[]
  findings      Finding[]
  dispatch      ScanDispatch?
  project       Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status, completedAt])
}

model ScanDispatch {
  scanId        String        @id
  jobId         String        @unique @db.VarChar(255)
  state         DispatchState @default(PENDING)
  attemptCount  Int           @default(0)
  nextAttemptAt DateTime      @default(now())
  lastAttemptAt DateTime?
  enqueuedAt    DateTime?
  lastErrorCode String?       @db.VarChar(100)
  leaseUntil    DateTime?
  updatedAt     DateTime      @updatedAt
  scan          Scan          @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@index([state, nextAttemptAt])
}

model Page {
  id       String    @id @default(cuid())
  scanId   String
  url      String    @db.VarChar(1000)
  title    String?
  status   Int?
  outcome  PageOutcome @default(PENDING)
  error    String?
  scan     Scan      @relation(fields: [scanId], references: [id], onDelete: Cascade)
  findings Finding[]

  @@index([scanId])
}

model Rule {
  id        String   @id
  title     String
  wcagRefs  String[]
  findings  Finding[]
}

model Finding {
  id              String       @id @default(cuid())
  scanId          String
  pageId          String
  ruleId          String
  severity        Severity
  fingerprint     String
  selector        String?
  message         String
  status          FindingStatus @default(OPEN)
  waivedAt        DateTime?
  waivedReason    String?
  waivedExpiresAt DateTime?
  scan            Scan         @relation(fields: [scanId], references: [id])
  page            Page         @relation(fields: [pageId], references: [id])
  rule            Rule         @relation(fields: [ruleId], references: [id])
  evidence        Evidence?
  @@unique([scanId, fingerprint], name: "scan_fingerprint")
  @@index([scanId, status])
}

model Evidence {
  id         String  @id @default(cuid())
  findingId  String  @unique
  screenshot String  @db.VarChar(500)
  domSnippet String?
  meta       Json?
  finding    Finding @relation(fields: [findingId], references: [id], onDelete: Cascade)
}

enum ScanStatus {
  pending
  queued
  crawling
  analyzing
  diffing
  evidence
  completed
  failed
}

enum ScanCoverage {
  PENDING
  COMPLETE
  PARTIAL
  FAILED
}

enum PageOutcome {
  PENDING
  ANALYZED
  FAILED
}

enum DispatchState {
  PENDING
  DISPATCHING
  ENQUEUED
  DEAD
}

enum Severity {
  MINOR
  MODERATE
  SERIOUS
  CRITICAL
}

enum FindingStatus {
  OPEN
  FIXED
  REGRESSED
  WAIVED
}
